# Copy to .env for local runs (never commit .env). On Render, set these in the dashboard: Environment.

# Shared secret required for recording, upload, download and delete. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_ACCESS_TOKEN=replace-with-a-long-random-secret

# Where recordings are written. Render's free tier disk is temporary (lost on restart/redeploy).
DATA_DIR=/tmp/phone-recordings

# Optional limits (defaults shown)
# MAX_SESSION_SECONDS=1800
# MAX_SESSION_BYTES=400000000
# MAX_TOTAL_BYTES=1500000000
# MAX_ACTIVE_SESSIONS=3
# SESSION_IDLE_TIMEOUT_S=600
# SESSION_TTL_S=21600

# Local development only: disable the token check entirely.
# APP_AUTH_DISABLED=1
